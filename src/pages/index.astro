---
import Layout from '../layouts/Layout.astro';
import { contact } from '../data/contact.js';
import '../styles/global.css';

const wa = `https://wa.me/${contact.whatsapp}?text=` + encodeURIComponent('Hola Santiago, vi tu portafolio y quiero consultarte por un proyecto.');
const words = ['Software', 'a medida', 'que hace', 'crecer', 'tu negocio.'];
const stack = ['Python', 'FastAPI', 'Flask', 'React', 'PWA', 'SQL', 'MongoDB', 'Docker', 'CI/CD', 'SEO técnico'];
const services = [
  ['Sistemas de gestión', 'Turnos, socios, pagos, stock. Reemplazamos planillas y papeles por un sistema que tu equipo usa todos los días.'],
  ['Apps web y PWA', 'Se instalan en el celular, funcionan rápido y no dependen de una tienda de aplicaciones.'],
  ['APIs y automatizaciones', 'Conectamos tus herramientas y automatizamos tareas repetitivas para que ganes horas por semana.'],
  ['Sitios que se encuentran', 'Landing pages veloces, con SEO técnico y datos estructurados para aparecer en Google, Bing y respuestas de IA.'],
];
const agency = [
  ['Desarrollo para tus clientes', 'Sitios, tiendas, landings y sistemas que tu agencia vende y yo construyo, con entregas claras y a tiempo.'],
  ['Trabajo en segundo plano', 'Puedo trabajar en modalidad marca blanca: vos llevás la relación con el cliente y yo me ocupo de la parte técnica.'],
  ['SEO técnico y velocidad', 'Sitios rápidos, con datos estructurados y listos para posicionar en buscadores y en respuestas de IA.'],
  ['Integraciones y automatización', 'Conexión con CRM, WhatsApp, pagos y herramientas de marketing, y reportes automáticos.'],
];
const sites = [
  ['Viajes de estudio de inglés', 'Sitio institucional con asesoramiento por WhatsApp', '/proyectos/viajes-estudio.jpg', 'https://www.englishbound.com.ar/', 'https://www.instagram.com/englishbound_/'],
  ['Alquiler de quincho con pileta', 'Sitio de reservas con galería, precios y consulta directa', '/proyectos/quincho.jpg', 'https://www.quinchoparaiso.com/', null],
  ['Gimnasio', 'Sitio con planes, instalaciones y contacto directo', '/proyectos/gimnasio-web.jpg', 'https://www.optimus-fitness-gym.com/', 'https://www.instagram.com/optimus_fitness_gym/'],
  ['Cabaña turística en Mar del Plata', 'Sitio ilustrado con galería, ubicación y reservas', '/proyectos/cabana.jpg', 'https://terraventuscomplejo.com/', 'https://www.instagram.com/terraventus.complejo/'],
  ['Asesoría de seguros', 'Sitio con cotizador y contacto por WhatsApp', '/proyectos/seguros.jpg', 'https://www.ases-integral.com/', null],
];
---
<Layout
  title="Santiago Schroh — Desarrollo de software a medida en Bahía Blanca"
  description="Desarrollo sistemas de gestión, apps web/PWA, APIs y sitios optimizados para SEO. Python y React. Bahía Blanca, Argentina; trabajo remoto en toda LATAM y España."
>
  <script is:inline>document.documentElement.classList.add('js')</script>
  <a class="skip" href="#proyectos">Ir al contenido</a>
  <div class="glow" aria-hidden="true"></div><div class="grain" aria-hidden="true"></div>

  <nav aria-label="Principal">
    <a class="logo" href="#top">SS<span style="color:var(--acc)">.</span></a>
    <ul>
      <li><a href="#proyectos">Proyectos</a></li>
      <li><a href="#servicios">Servicios</a></li>
      <li><a href="#agencias">Agencias</a></li>
      <li><a href="#contacto">Contacto</a></li>
    </ul>
  </nav>

  <header class="hero" id="top">
    <div class="wrap">
      <p class="badge"><span class="dot"></span>Disponible · Bahía Blanca y remoto</p>
      <h1 aria-label="Software a medida que hace crecer tu negocio.">
        {words.map((w, i) => (
          <span class="line" aria-hidden="true"><span class="word" set:html={i === 3 ? `<em>${w}</em>` : w} /></span>
        ))}
      </h1>
      <p class="lead">Soy Santiago, desarrollador. Diseño y programo sistemas, apps y sitios que ya funcionan en producción, con foco en velocidad, posicionamiento y resultados.</p>
      <div class="cta">
        <a class="btn primary" href={wa} target="_blank" rel="noopener">Contame tu proyecto ↗</a>
        <a class="btn" href="#proyectos">Ver proyectos</a>
      </div>
    </div>
  </header>

  <div class="marquee" aria-hidden="true"><div class="track">{stack.map((s) => <span>{s}</span>)}</div></div>

  <main>
    <section id="proyectos">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Proyectos</p>
        <h2 data-reveal>Menos promesas, más sistemas en producción.</h2>

        <article class="feature store gym" data-reveal>
          <div class="shots">
            <img src="/proyectos/gym-inicio.jpg" alt="Panel de inicio del sistema de gimnasio con ingresos y alertas" width="1350" height="682" loading="lazy" decoding="async" />
            <img src="/proyectos/gym-clientes.jpg" alt="Listado de socios con estado de cuota y vencimiento" width="1342" height="678" loading="lazy" decoding="async" />
            <img src="/proyectos/gym-caja.jpg" alt="Caja por turno con movimientos y resumen" width="1342" height="687" loading="lazy" decoding="async" />
            <img src="/proyectos/gym-productos.jpg" alt="Inventario de productos con precio, costo y margen" width="1365" height="682" loading="lazy" decoding="async" />
            <img src="/proyectos/gym-rutinas.jpg" alt="Biblioteca de rutinas de entrenamiento" width="1341" height="708" loading="lazy" decoding="async" />
          </div>
          <div class="body">
            <p class="eyebrow">Proyecto destacado · Sistema en producción</p>
            <h3>Tu Gimnasio Virtual</h3>
            <p style="color:var(--mut)">Sistema de gestión para gimnasios, creado a partir de un caso real en Bahía Blanca: socios, cuotas, caja, productos y rutinas en un solo lugar.</p>
            <ul class="facts">
              <li>Socios con estado de cuota (al día, por vencer, vencidos) y seguimiento de pagos</li>
              <li>Caja por turno, venta de productos e inventario con costo y margen</li>
              <li>Biblioteca de rutinas, ingreso por DNI en recepción y varias sucursales</li>
              <li>Equipo con roles y permisos, y color de marca configurable</li>
              <li>En producción y en uso por el cliente</li>
            </ul>
            <ul class="tags"><li>Python</li><li>Flask · FastAPI</li><li>React</li><li>Tailwind</li><li>SQL</li><li>JWT</li></ul>
            <a class="btn" href="https://github.com/SchrohSantiago/GymSystem-releases" target="_blank" rel="noopener">Ver versiones ↗</a>
          </div>
        </article>

        <article class="feature store" data-reveal>
          <div class="body">
            <p class="eyebrow">Sistema en producción</p>
            <h3>Tu Tienda Virtual</h3>
            <p style="color:var(--mut)">Inventario, ventas y tienda online desde un solo panel, funcionando hoy para un comercio de tecnología y accesorios.</p>
            <ul class="facts">
              <li>Panel de administración: productos, categorías, proveedores, clientes, pedidos y caja</li>
              <li>Importación de planillas y sincronización con proveedores</li>
              <li>Tienda online con combos, carrito y pedido para coordinar el pago y el envío</li>
            </ul>
            <ul class="tags"><li>Panel de administración</li><li>Tienda online</li><li>Inventario</li></ul>
          </div>
          <div class="shots">
            <img src="/proyectos/tienda-panel.jpg" alt="Panel de administración de Tu Tienda Virtual con listado de productos" width="1059" height="595" loading="lazy" decoding="async" />
            <img src="/proyectos/tienda-combos.jpg" alt="Tienda online con combos y precios" width="1346" height="519" loading="lazy" decoding="async" />
            <img src="/proyectos/tienda-carrito.jpg" alt="Carrito de compras de la tienda online" width="1354" height="463" loading="lazy" decoding="async" />
            <img src="/proyectos/tienda-login.jpg" alt="Pantalla de ingreso de Tu Tienda Virtual" width="660" height="592" loading="lazy" decoding="async" />
          </div>
        </article>

        <article class="feature store" data-reveal>
          <div class="body">
            <p class="eyebrow">Sistema en producción</p>
            <h3>Sistema de gestión para agencia de viajes</h3>
            <p style="color:var(--mut)">Clientes, viajes, pagos, caja y facturación en un solo lugar, para el trabajo diario de una agencia.</p>
            <ul class="facts">
              <li>Ficha de cada cliente con documentación, acompañantes, viaje y estado de pago</li>
              <li>Paquetes, destinos y servicios, y seguimiento de proveedores</li>
              <li>Caja en pesos y dólares con gráficos, cotización del dólar oficial y facturación electrónica con ARCA</li>
              <li>Usuarios con roles de acceso</li>
            </ul>
            <ul class="tags"><li>Gestión de clientes</li><li>Caja multimoneda</li><li>Facturación ARCA</li></ul>
          </div>
          <div class="shots">
            <img src="/proyectos/togo-inicio.jpg" alt="Panel de inicio del sistema de gestión para agencia de viajes" width="1365" height="593" loading="lazy" decoding="async" />
            <img src="/proyectos/togo-clientes.jpg" alt="Listado de clientes con viaje, destino y estado de pago" width="1346" height="594" loading="lazy" decoding="async" />
            <img src="/proyectos/togo-viajes.jpg" alt="Gestión de paquetes, destinos y servicios de viaje" width="1365" height="591" loading="lazy" decoding="async" />
            <img src="/proyectos/togo-caja.jpg" alt="Caja en pesos y dólares con gráficos de ingresos y egresos" width="1346" height="584" loading="lazy" decoding="async" />
            <img src="/proyectos/togo-facturacion.jpg" alt="Facturación electrónica y recibos integrados con ARCA" width="1363" height="589" loading="lazy" decoding="async" />
          </div>
        </article>

        <div class="stats" data-reveal>
          <div class="stat"><b data-count="2" data-suffix=" años">2 años</b><span>desarrollando backend en plataformas productivas de alta criticidad</span></div>
          <div class="stat"><b>Releases</b><span>coordinados a producción con CI/CD en múltiples ambientes</span></div>
          <div class="stat"><b>En producción</b><span>sistema propio de punta a punta para un gimnasio de Bahía Blanca</span></div>
        </div>

        <h3 class="sub" data-reveal>Sitios web en producción</h3>
        <div class="grid sites">
          {sites.map(([t, d, img, url, ig]) => (
            <article class="site" data-reveal>
              <a href={url} target="_blank" rel="noopener" aria-label={`${t}: ver sitio en vivo`}>
                <img src={img} alt={`Captura del sitio: ${t}`} width="800" height="600" loading="lazy" decoding="async" />
              </a>
              <div class="info">
                <h3>{t}</h3>
                <p>{d}</p>
                <p class="links"><a href={url} target="_blank" rel="noopener">Ver sitio ↗</a>{ig && <a href={ig} target="_blank" rel="noopener">Instagram ↗</a>}</p>
              </div>
            </article>
          ))}
        </div>
        </div>
      </div>
    </section>

    <section id="servicios">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Servicios</p>
        <h2 data-reveal>Lo que puedo construir para vos.</h2>
        <div class="grid">
          {services.map(([t, d], i) => (
            <div class="card" data-reveal>
              <span class="n">0{i + 1}</span>
              <h3>{t}</h3>
              <p>{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="agencias">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Para agencias</p>
        <h2 data-reveal>Tu equipo de desarrollo, sin sumar sueldos.</h2>
        <div class="grid">
          {agency.map(([t, d]) => (
            <div class="card" data-reveal>
              <h3>{t}</h3>
              <p>{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contacto" class="contact">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Contacto</p>
        <h2 data-reveal>¿Hablamos de tu proyecto?</h2>
        <div class="cta" data-reveal>
          <a class="btn primary" href={wa} target="_blank" rel="noopener">Escribime por WhatsApp ↗</a>
          <a class="btn" href="/curriculumSchroh.pdf" download>Descargar CV</a>
        </div>
        <a class="big" href={`mailto:${contact.email}`} data-reveal>{contact.email}</a>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span>© {new Date().getFullYear()} Santiago Schroh · Bahía Blanca, Argentina</span>
      <span><a href={contact.github} rel="noopener">GitHub</a> · <a href={contact.linkedin} rel="noopener">LinkedIn</a></span>
    </div>
  </footer>

  <script>import '../scripts/animations.js';</script>
</Layout>
